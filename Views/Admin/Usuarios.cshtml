@model List<(Microsoft.AspNetCore.Identity.IdentityUser User, IList<string> Roles)>
@{ ViewData["Title"] = "Administración de usuarios"; }

<section class="container" style="margin-top:2rem">
    <h2 class="ts-section__title">Usuarios registrados</h2>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th>Roles</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (user, roles) in Model)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>
                            @if (roles.Any())
                            {
                                @string.Join(", ", roles)
                            }
                            else
                            {
                                <span class="text-muted">Sin rol</span>
                            }
                        </td>
                        <td>
                            @if (!roles.Contains("Administrador"))
                            {
                                <form asp-action="AsignarRol" method="post" style="display:inline">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="rol" value="Administrador" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Hacer Admin</button>
                                </form>
                            }
                            @if (roles.Contains("Administrador") && user.UserName != "admin")
                            {
                                <form asp-action="QuitarRol" method="post" style="display:inline">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="rol" value="Administrador" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Quitar Admin</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
