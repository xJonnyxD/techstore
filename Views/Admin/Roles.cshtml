@model List<Microsoft.AspNetCore.Identity.IdentityRole>
@{ ViewData["Title"] = "Roles del sistema"; }

<section class="container" style="margin-top:2rem">
    <h2 class="ts-section__title">Roles del sistema</h2>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre del rol</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rol in Model)
                {
                    <tr>
                        <td><code>@rol.Id</code></td>
                        <td><strong>@rol.Name</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
