@model Categoria
@{
    ViewData["Title"] = "Eliminar categoría";
    var cantidad = Model.Productos?.Count ?? 0;
}

<section class="ts-section container">
    <div class="ts-section__head">
        <h1>Eliminar categoría</h1>
        <p>Esta acción no se puede deshacer.</p>
    </div>

    <div class="ts-confirm">
        <p>¿Seguro que deseas eliminar la categoría <strong>«@Model.Nombre»</strong>?</p>
        @if (cantidad > 0)
        {
            <div class="ts-alert ts-alert--error">
                No se puede eliminar: tiene @cantidad producto(s) asociado(s). Reasigna o elimina esos productos primero.
            </div>
        }
        <form asp-action="Eliminar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="ts-form__actions">
                <button type="submit" class="ts-btn ts-btn--danger" disabled="@(cantidad > 0)">Sí, eliminar</button>
                <a asp-action="Index" class="ts-btn ts-btn--outline">Cancelar</a>
            </div>
        </form>
    </div>
</section>
