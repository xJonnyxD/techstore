@model IEnumerable<Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<section class="ts-section container">
    <div class="ts-toolbar">
        <div class="ts-section__head" style="margin-bottom:0">
            <h1>Gestión de categorías</h1>
            <p>Organizamos la tienda para que encuentres todo más rápido.</p>
        </div>
        <a class="ts-btn ts-btn--primary" asp-action="Crear">+ Nueva categoría</a>
    </div>

    <div class="ts-catgrid">
        @foreach (var categoria in Model)
        {
            <article class="ts-catcard">
                <div class="ts-catcard__media">
                    <img src="~/images/@categoria.Imagen" alt="@categoria.Nombre" />
                </div>
                <div class="ts-catcard__body">
                    <h2>@categoria.Nombre</h2>
                    <p>@categoria.Descripcion</p>
                    <div class="ts-actions">
                        <a class="ts-btn ts-btn--sm ts-btn--light" asp-action="Editar" asp-route-id="@categoria.Id">Editar</a>
                        <a class="ts-btn ts-btn--sm ts-btn--danger" asp-action="Eliminar" asp-route-id="@categoria.Id">Eliminar</a>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
