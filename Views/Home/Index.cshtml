@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Inicio";
    var categorias = ViewBag.Categorias as IEnumerable<Categoria> ?? new List<Categoria>();
}

<!-- Hero -->
<section class="ts-hero">
    <div class="container ts-hero__inner">
        <div class="ts-hero__content">
            <span class="ts-hero__tag">Tienda de tecnología</span>
            <h1>Tecnología actual, al alcance de todos.</h1>
            <p>Laptops, smartphones y accesorios seleccionados para estudiar, trabajar y jugar.</p>
            <div class="ts-hero__actions">
                <a class="ts-btn ts-btn--primary" asp-controller="Productos" asp-action="Index">Ver productos</a>
                <a class="ts-btn ts-btn--ghost" asp-controller="Categorias" asp-action="Index">Ver categorías</a>
            </div>
        </div>
        <div class="ts-hero__art" aria-hidden="true">
            <img src="~/images/hero.svg" alt="" />
        </div>
    </div>
</section>

<!-- Productos destacados -->
<section class="ts-section container">
    <header class="ts-section__head ts-section__head--row">
        <div>
            <h2>Productos destacados</h2>
            <p>Una muestra de lo más buscado en la tienda.</p>
        </div>
        <a class="ts-link" asp-controller="Productos" asp-action="Index">Ver todos &rarr;</a>
    </header>

    <div class="ts-grid">
        @foreach (var producto in Model)
        {
            <partial name="_ProductCard" model="producto" />
        }
    </div>
</section>

<!-- Categorías -->
<section class="ts-section ts-section--soft">
    <div class="container">
        <header class="ts-section__head">
            <h2>Categorías principales</h2>
            <p>Encuentra lo que buscas por tipo de producto.</p>
        </header>

        <div class="ts-cats">
            @foreach (var categoria in categorias)
            {
                <a class="ts-cat" asp-controller="Categorias" asp-action="Index">
                    <img src="~/images/@categoria.Imagen" alt="@categoria.Nombre" />
                    <span class="ts-cat__name">@categoria.Nombre</span>
                </a>
            }
        </div>
    </div>
</section>

<!-- Beneficios -->
<section class="ts-section container">
    <header class="ts-section__head">
        <h2>¿Por qué comprar aquí?</h2>
    </header>

    <div class="ts-benefits">
        <div class="ts-benefit">
            <span class="ts-benefit__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
            <h3>Envío rápido</h3>
            <p>Entregas ágiles en todo el país.</p>
        </div>
        <div class="ts-benefit">
            <span class="ts-benefit__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </span>
            <h3>Productos seleccionados</h3>
            <p>Solo marcas confiables y probadas.</p>
        </div>
        <div class="ts-benefit">
            <span class="ts-benefit__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </span>
            <h3>Soporte cercano</h3>
            <p>Te ayudamos antes y después de tu compra.</p>
        </div>
        <div class="ts-benefit">
            <span class="ts-benefit__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <h3>Compra segura</h3>
            <p>Tus datos y tu pago siempre protegidos.</p>
        </div>
    </div>
</section>
