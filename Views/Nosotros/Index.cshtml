@{
    ViewData["Title"] = "Nosotros";
}

<section class="ts-section container ts-about">
    <header class="ts-section__head">
        <h1>Acerca de nosotros</h1>
        <p>TechStore nace como una propuesta enfocada en acercar tecnología actual a
           estudiantes, profesionales y usuarios que buscan productos confiables.</p>
    </header>

    <div class="ts-about__grid">
        <article class="ts-about__card">
            <h2>Historia</h2>
            <p>Somos un proyecto estudiantil que reúne una selección de productos
               tecnológicos en una tienda sencilla y fácil de usar.</p>
        </article>
        <article class="ts-about__card">
            <h2>Misión</h2>
            <p>Ofrecer tecnología confiable a buen precio, con una experiencia de
               compra clara y directa.</p>
        </article>
        <article class="ts-about__card">
            <h2>Visión</h2>
            <p>Ser una tienda de referencia para quienes buscan productos tecnológicos
               útiles para su estudio y trabajo.</p>
        </article>
        <article class="ts-about__card">
            <h2>Valores</h2>
            <ul>
                <li>Confianza</li>
                <li>Calidad</li>
                <li>Cercanía</li>
                <li>Responsabilidad</li>
            </ul>
        </article>
    </div>
</section>
