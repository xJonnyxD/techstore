<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <link rel="icon" href="~/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" href="~/favicon.png?v=2" sizes="64x64" />
    <link rel="apple-touch-icon" href="~/favicon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg ts-navbar">
            <div class="container">
                <a class="navbar-brand ts-brand" asp-controller="Home" asp-action="Index">
                    <span class="ts-brand__logo">TS</span>
                    <span class="ts-brand__text"><span class="ts-brand__mark">Tech</span>Store</span>
                    <span class="ts-brand__ver">v2.0</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                        aria-controls="navMenu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Productos" asp-action="Index">Productos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Contacto" asp-action="Index">Contáctenos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Nosotros" asp-action="Index">Nosotros</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (TempData["Exito"] is string mensajeExito)
        {
            <div class="container"><div class="ts-alert ts-alert--ok" style="margin-top:1.5rem">@mensajeExito</div></div>
        }
        @if (TempData["Error"] is string mensajeError)
        {
            <div class="container"><div class="ts-alert ts-alert--error" style="margin-top:1.5rem">@mensajeError</div></div>
        }
        @RenderBody()
    </main>

    <footer class="ts-footer">
        <div class="container ts-footer__inner">
            <div>
                <p class="ts-footer__brand"><span class="ts-brand__mark">Tech</span>Store</p>
                <p class="ts-footer__text">Tecnología actual para estudiantes y profesionales.</p>
            </div>
            <div>
                <h4>Enlaces</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li><a asp-controller="Productos" asp-action="Index">Productos</a></li>
                    <li><a asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                    <li><a asp-controller="Nosotros" asp-action="Index">Nosotros</a></li>
                </ul>
            </div>
            <div>
                <h4>Contacto</h4>
                <p class="ts-footer__text">
                    San Salvador, El Salvador<br />
                    contacto@techstore.yanes.xyz<br />
                    +503 2222-3333
                </p>
            </div>
        </div>
        <div class="ts-footer__bottom">
            &copy; 2026 TechStore. Todos los derechos reservados.
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
