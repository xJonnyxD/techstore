@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }

<section class="container text-center" style="margin-top:4rem">
    <h1 style="font-size:4rem;font-weight:800;color:var(--ts-primary,#2563eb)">@(ViewData["StatusCode"] ?? "Error")</h1>
    <p class="lead">@(ViewData["Mensaje"] ?? "Ocurrió un error inesperado.")</p>

    @if (Model?.RequestId is not null)
    {
        <p class="text-muted" style="font-size:.85rem">ID de solicitud: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al inicio</a>
</section>
