@model Producto
@{
    var categorias = ViewBag.Categorias as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div asp-validation-summary="ModelOnly" class="ts-form__error"></div>

<div class="ts-field">
    <label asp-for="Nombre"></label>
    <input asp-for="Nombre" class="ts-input" />
    <span asp-validation-for="Nombre" class="ts-form__error"></span>
</div>

<div class="ts-field">
    <label asp-for="Descripcion"></label>
    <textarea asp-for="Descripcion" class="ts-input" rows="3"></textarea>
    <span asp-validation-for="Descripcion" class="ts-form__error"></span>
</div>

<div class="ts-formrow">
    <div class="ts-field">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" class="ts-input" type="number" step="0.01" min="0" />
        <span asp-validation-for="Precio" class="ts-form__error"></span>
    </div>
    <div class="ts-field">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" class="ts-input" type="number" min="0" />
        <span asp-validation-for="Stock" class="ts-form__error"></span>
    </div>
</div>

<div class="ts-formrow">
    <div class="ts-field">
        <label asp-for="CategoriaId"></label>
        <select asp-for="CategoriaId" class="ts-select" asp-items="categorias">
            <option value="">— Seleccione una categoría —</option>
        </select>
        <span asp-validation-for="CategoriaId" class="ts-form__error"></span>
    </div>
    <div class="ts-field">
        <label asp-for="Imagen"></label>
        <input asp-for="Imagen" class="ts-input" placeholder="ej. laptop.svg" />
        <span asp-validation-for="Imagen" class="ts-form__error"></span>
    </div>
</div>

<div class="ts-field">
    <label class="ts-check">
        <input asp-for="Estado" type="checkbox" />
        <span>Producto activo</span>
    </label>
</div>
