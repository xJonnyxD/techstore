@model Producto
@{
    ViewData["Title"] = "Eliminar producto";
}

<section class="ts-section container">
    <div class="ts-section__head">
        <h1>Eliminar producto</h1>
        <p>Esta acción no se puede deshacer.</p>
    </div>

    <div class="ts-confirm">
        <p>¿Seguro que deseas eliminar el producto <strong>«@Model.Nombre»</strong> de la categoría <strong>@(Model.Categoria?.Nombre ?? "—")</strong>?</p>
        <form asp-action="Eliminar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="ts-form__actions">
                <button type="submit" class="ts-btn ts-btn--danger">Sí, eliminar</button>
                <a asp-action="Index" class="ts-btn ts-btn--outline">Cancelar</a>
            </div>
        </form>
    </div>
</section>
